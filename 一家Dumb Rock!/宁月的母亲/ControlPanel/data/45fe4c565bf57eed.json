  "voices": [
    {
      "id": 0,
      "name": "『四宮寧月』が、あんなどこの馬の骨とも知らない 下流の人間と同じものを選ぶなんて、あってはならないの",
      "caption": "『四宮寧月』が、あんなどこの馬の骨とも知らない\n下流の人間と同じものを選ぶなんて、あってはならないの",
      "file": "assets/voices/curated_adv_voice_eventstory_8_06_055.wav",
      "duration": 10.126,
      "flag": "heart_fav_f84a736ffadb00ca"
    },
    {
      "id": 1,
      "name": "いい？ あなたはクラシック界の神童であり 音楽家『四宮絃一郎』の娘なのよ",
      "caption": "いい？　あなたはクラシック界の神童であり\n音楽家『四宮絃一郎』の娘なのよ",
      "file": "assets/voices/curated_adv_voice_eventstory_8_06_054.wav",
      "duration": 8.69,
      "flag": "heart_fav_ceb4d76d287dfd3e"
    },
    {
      "id": 2,
      "name": "ええ、そうなんです。 自由時間はバルコニーで読書をしているんですのよ",
      "caption": "ええ、そうなんです。\n自由時間はバルコニーで読書をしているんですのよ",
      "file": "assets/voices/curated_adv_voice_eventstory_8_06_079.wav",
      "duration": 5.178,
      "flag": "heart_fav_17e95c4e62e813fa"
    },
    {
      "id": 3,
      "name": "ズボンも素敵だけれど、 お母さまはこれが寧月に似合うと思うわ",
      "caption": "ズボンも素敵だけれど、\nお母さまはこれが寧月に似合うと思うわ",
      "file": "assets/voices/curated_adv_voice_eventstory_8_06_044.wav",
