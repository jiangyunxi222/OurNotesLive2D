      "bytes": 404740,
      "seconds": 4.588,
      "path": "assets/voices/source_BandTop_Miku_Summer_01.wav",
      "subtitle": "茄子降价了。做成日式高汤煎茄子吧"
    },
    {
      "slug": "miku",
      "provider": "bdon.moe",
      "speaker": "miku",
