      "nativeSha256": "d95ab6aa5abca1f16359cab2fe890ee9a45b373170772a9c9bee817214fa8f72",
      "bytes": 187038,
      "seconds": 2.12,
      "path": "assets/voices/source_BandTop_Miku_Common_01.wav",
      "subtitle": "要练习，对吧？"
    },
    {
      "slug": "miku",
      "provider": "bdon.moe",
      "speaker": "miku",
      "characterId": 22,
      "text": "不管是Family还是联盟，都不想在外面被别人听到……",
      "textId": "Talk_Text_443",
