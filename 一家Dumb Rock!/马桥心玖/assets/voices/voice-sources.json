    },
    {
      "cue": "adv_voice_anotherstory_10972_030",
      "game": "OurNotes",
      "episode": "adv_voice_anotherstory_10972",
      "speaker": "miku",
      "text": "それぞれもうやることがわかってる感じとか 動きに無駄がないところとか",
