      "bytes": 315042,
      "seconds": 3.571,
      "path": "assets/voices/source_BandTop_Miku_Common_03.wav",
      "subtitle": "下雨了！？衣服还晾在外面呢……！"
    },
    {
      "slug": "miku",
      "provider": "bdon.moe",
      "speaker": "miku",
      "characterId": 22,
      "text": "啊，春季洋葱……已经到这个时节了啊",
      "textId": "Talk_Text_445",
      "pageUrl": "https://bdon.moe/character-voices.json",
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/VoiceSystem_22/BandTop_Miku_Spring_01.m4a",
