      "evidence": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_kadan_005_1_10/adv_script_kadan_005_1_10-Episode/adv_script_kadan_005_1_10-Episode.json.br",
