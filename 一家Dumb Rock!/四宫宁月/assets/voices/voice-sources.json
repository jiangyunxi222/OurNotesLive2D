      "evidence": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_kadan_005_1_08/adv_script_kadan_005_1_08-Episode/adv_script_kadan_005_1_08-Episode.json.br",
      "discussion": "",
      "pcm_sha256": "6946244cbeef0bf3ce1ac771d23d226646abe2099af4f908049964fc3664a2b1",
      "path": "assets/voices/curated_adv_voice_kadan_005_1_08_094.wav",
      "subtitle": "我对Family和Home都还在摸索当中。\n万一失去了，就会永远弄不明白",
      "personality": null,
      "source_sha256": "16c790b5eeb63d34fbf0002e25b9106eca172f77c946dd238c9ea306050c7f24",
      "subtitleSource": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_kadan_005_1_08/adv_script_kadan_005_1_08-Text/adv_script_kadan_005_1_08-Text.json.br"
    },
