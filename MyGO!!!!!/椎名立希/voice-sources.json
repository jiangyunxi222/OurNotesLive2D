      "seconds": 1.576,
      "path": "assets/voices/source_adv_voice_mygo_001_1_13_014.wav",
      "subtitle": "……喂。过来一下"
    },
    {
      "slug": "taki",
      "provider": "bdon.moe",
      "speaker": "taki",
      "speakerId": "adv_taki",
      "text": "那家伙没问题吧……",
