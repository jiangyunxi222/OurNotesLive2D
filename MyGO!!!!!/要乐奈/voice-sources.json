      "seconds": 5.62,
      "path": "assets/voices/source_BandTop_Rana_Summer_01.wav",
      "subtitle": "外面好热。RiNG里很凉快，舒服"
    },
    {
      "slug": "rana",
      "provider": "bdon.moe",
      "speaker": "rana",
      "characterId": 3,
