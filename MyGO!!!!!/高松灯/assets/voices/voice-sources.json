      "index": 299,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_mygo_001_1_13/adv_voice_mygo_001_1_13_032.m4a",
      "cue": "adv_voice_mygo_001_1_13_032",
      "sourceType": "story",
