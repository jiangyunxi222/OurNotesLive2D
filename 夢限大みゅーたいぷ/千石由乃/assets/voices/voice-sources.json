    },
    {
      "cue": "adv_voice_yumemita_003_1_16_124",
      "game": "OurNotes",
      "episode": "10055",
      "speaker": "yuno",
      "text": "あたしたちが叶えた夢、こんなもんじゃない。 ずっと増え続けるから",
