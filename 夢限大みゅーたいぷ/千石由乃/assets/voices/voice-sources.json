    },
    {
      "cue": "adv_voice_yumemita_003_1_04_108",
      "game": "OurNotes",
      "episode": "10043",
      "speaker": "yuno",
      "text": "ていうか、もっと気にした方がいいやついるんじゃない？ ボーカルとか",
