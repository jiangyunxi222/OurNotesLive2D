      "personality": null
    },
    {
      "cue": "adv_voice_yumemita_003_1_12_050",
      "game": "OurNotes",
      "episode": "10051",
      "speaker": "yuno",
      "text": "そうやってちょっとずつ音がハマってくのが バンドの醍醐味なんだから",
