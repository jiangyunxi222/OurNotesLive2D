    {
      "cue": "adv_voice_yumemita_003_1_04_282",
      "game": "OurNotes",
      "episode": "10043",
      "speaker": "yuno",
      "text": "スパっと諦められるんなら、苦労しないし…… 終わりたくないんでしょ",
