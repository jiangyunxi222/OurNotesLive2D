      "evidence": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_yumemita_003_1_09/adv_script_yumemita_003_1_09-Episode/adv_script_yumemita_003_1_09-Episode.json.br",
