      "cues": [
        "adv_voice_anotherstory_10446_014"
      ],
      "text": "——原来如此。\n关于这次活动的风波，我要问的就这些了",
      "evidenceType": "cue_and_text",
      "source": [
        {
          "cue": "adv_voice_anotherstory_10446_014",
