      "sha256": "2115a9fe749c8e314205357f1d5f9d512dec0f22f265adbd100ac57fa651159a",
      "nativeSha256": "f21ce2d33f8b571247dce885d02e476ceb3cff4e6dc51690aff1237b2ff61328",
      "bytes": 403680,
      "seconds": 4.576,
      "path": "assets/voices/source_BandTop_Sakiko_Common_01.wav",
      "subtitle": "读书的时间让人很放松呢。如果还有红茶的话就更好了"
    },
    {
