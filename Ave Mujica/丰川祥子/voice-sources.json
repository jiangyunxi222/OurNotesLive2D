    {
      "slug": "sakiko",
      "provider": "bdon.moe",
      "speaker": "sakiko",
      "speakerId": "adv_sakiko",
      "text": "——你愿意，将剩余的人生交给我吗？",
      "textId": "adv_script_mujica_002_1_02_97",
