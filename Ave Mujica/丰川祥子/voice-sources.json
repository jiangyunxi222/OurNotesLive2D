      "bytes": 132620,
      "seconds": 1.503,
      "path": "assets/voices/source_adv_voice_mygo_001_1_14_123.wav",
      "subtitle": "别假装为大家着想了"
    },
    {
      "slug": "sakiko",
      "provider": "bdon.moe",
      "speaker": "sakiko",
      "speakerId": "adv_sakiko",
      "text": "啊，不对……\n花也是有生命的……",
