      "bytes": 530596,
      "seconds": 6.015,
      "path": "assets/voices/source_BandTop_Sakiko_Common_02.wav",
      "subtitle": "作曲、剧本、导演……时间再多都不够用"
    },
    {
      "slug": "sakiko",
      "provider": "bdon.moe",
      "speaker": "sakiko",
      "characterId": 10,
      "text": "我一定会将乐队守护到底，这就是我的决心",
