      "bytes": 259386,
      "seconds": 2.94,
      "path": "assets/voices/source_adv_voice_eventstory_7_04_040.wav",
      "subtitle": "我，成了一个不努力的人"
    },
    {
      "slug": "nagi",
      "provider": "bdon.moe",
      "speaker": "nagi",
      "speakerId": "adv_nagi",
      "text": "这样啊。\n对了……联系上枣学姐了吗？",
