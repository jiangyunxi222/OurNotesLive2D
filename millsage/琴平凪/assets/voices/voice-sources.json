      "cue": "adv_voice_millsage_004_1_03_104",
      "sourceType": "story",
      "sha256": "40b5a9746e0530689f878712401d0ae497f37f3ed226689ce393a48d20429e4d",
      "nativeSha256": "ffcd9b9ddc305dedca5256d86eaea36b63a7bd9160bd02c3ef8d1afb2bc9db7f",
      "bytes": 462676,
      "seconds": 5.245,
      "path": "assets/voices/source_adv_voice_millsage_004_1_03_104.wav",
      "subtitle": "这样啊。\n对了……联系上枣学姐了吗？"
    },
    {
      "slug": "nagi",
      "provider": "bdon.moe",
      "speaker": "nagi",
      "speakerId": "adv_nagi",
      "text": "这次再怎么说都是奏多的错吧？",
