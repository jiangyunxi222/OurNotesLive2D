      "index": 212,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_12/adv_voice_millsage_004_1_12_026.m4a",
      "cue": "adv_voice_millsage_004_1_12_026",
      "sourceType": "story",
      "sha256": "712419a86f7866b27333b3d221c954dedf71594287d02d6979fda13361d59037",
      "nativeSha256": "51660f65834785f769c4fded6036e09c60667d593f15634379e7c27f2bfbd234",
      "bytes": 115604,
      "seconds": 1.31,
      "path": "assets/voices/source_adv_voice_millsage_004_1_12_026.wav",
      "subtitle": "完美啦"
    },
    {
      "slug": "nagi",
      "provider": "bdon.moe",
      "speaker": "nagi",
      "speakerId": "adv_nagi",
      "text": "……就是明天了呢，演出",
      "textId": "adv_script_millsage_004_1_15_50",
