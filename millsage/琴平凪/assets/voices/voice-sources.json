      "pageUrl": "https://bdon.moe/story/10063",
      "index": 937,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_135.m4a",
      "cue": "adv_voice_millsage_004_1_04_135",
      "sourceType": "story",
      "sha256": "22b1527b62dc99877b32cd3df539a8c1245110738edb308e26f394a41e7dee2e",
      "nativeSha256": "2c9493fdd1f9b724a2299c2b7b2f2ba82d267afd74a47c738db3344fe0e04775",
      "bytes": 679660,
      "seconds": 7.705,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_135.wav",
      "subtitle": "……啊，想起来了。\n她就是传闻里那个霸占着天台、谁都不让靠近的学姐"
    },
    {
      "slug": "nagi",
      "provider": "bdon.moe",
      "speaker": "nagi",
      "speakerId": "adv_nagi",
      "text": "完美啦",
