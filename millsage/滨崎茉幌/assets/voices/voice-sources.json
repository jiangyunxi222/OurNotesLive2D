    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "……你好，小萤",
      "textId": "adv_script_millsage_004_1_03_125",
      "pageUrl": "https://bdon.moe/story/10062",
      "index": 690,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_03/adv_voice_millsage_004_1_03_121.m4a",
      "cue": "adv_voice_millsage_004_1_03_121",
      "sourceType": "story",
      "sha256": "2940e9a2ce02b0dc87d8170df3f2b0eabf8057d5318f7cbc416b02f17a510ba6",
      "nativeSha256": "6882cbb53d5882fe6526a26b88e47d0d15c0389a3e49578fd4636cdc1a998609",
      "bytes": 160602,
      "seconds": 1.82,
      "path": "assets/voices/source_adv_voice_millsage_004_1_03_121.wav",
      "subtitle": "……你好，小萤"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "哇～真是的，大家不用管我啦！\n辛苦了，回见！",
      "textId": "adv_script_millsage_004_1_13_45",
      "pageUrl": "https://bdon.moe/story/10072",
      "index": 285,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_13/adv_voice_millsage_004_1_13_043.m4a",
