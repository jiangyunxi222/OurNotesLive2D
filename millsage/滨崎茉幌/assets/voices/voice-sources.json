      "sourceType": "story",
      "sha256": "cf1fd49a7501120c726adacf55c9ada03b888b02a205237372ff4184cbd52ed5",
      "nativeSha256": "d52a508b7338bd5700deb93c225c2bcce32dd1e4b9915d1fb1ebc35492028be3",
      "bytes": 389394,
      "seconds": 4.414,
      "path": "assets/voices/source_adv_voice_millsage_004_1_13_043.wav",
      "subtitle": "哇～真是的，大家不用管我啦！\n辛苦了，回见！"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "这样啊……抱歉吓到你了吧。\n这个视频最近在社交网站上挺火的",
      "textId": "adv_script_millsage_004_1_02_100",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 552,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_088.m4a",
      "cue": "adv_voice_millsage_004_1_02_088",
      "sourceType": "story",
      "sha256": "665f817dce78bbead70b8475bdf77da77635d69031feaac4002cd226c25e4a6b",
      "nativeSha256": "3f7d0c15998250466b1a5fb05df832471aedfb588817be77134ed20c82b38829",
      "bytes": 650632,
      "seconds": 7.376,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_088.wav",
      "subtitle": "这样啊……抱歉吓到你了吧。\n这个视频最近在社交网站上挺火的"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "嗯。谢谢你",
      "textId": "adv_script_millsage_004_1_06_87",
      "pageUrl": "https://bdon.moe/story/10065",
      "index": 546,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_06/adv_voice_millsage_004_1_06_084.m4a",
      "cue": "adv_voice_millsage_004_1_06_084",
      "sourceType": "story",
      "sha256": "40a360a20118a91a7b36da4b81bcaf0082044336335b1cef39615693df7f825e",
      "nativeSha256": "fa58319deb6af65a8799cbfeedd34952dfa8c796102bf469ef0cb2babf2fb294",
      "bytes": 151960,
      "seconds": 1.722,
      "path": "assets/voices/source_adv_voice_millsage_004_1_06_084.wav",
      "subtitle": "嗯。谢谢你"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "都说了对不起啦～！",
      "textId": "adv_script_natsume_mahoro_linkstory_1_45",
      "pageUrl": "https://bdon.moe/story/10564",
      "index": 260,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_linkstory_natsume_mahoro_10564/adv_voice_linkstory_natsume_mahoro_10564_044.m4a",
      "cue": "adv_voice_linkstory_natsume_mahoro_10564_044",
      "sourceType": "story",
      "sha256": "1c09d285f545aa73ee5c84b5aab6a98228c12d496ce020ec278cff02b4ee15a8",
      "nativeSha256": "d2639fea4e512f2fef3782201180fe6e2e01f858baa730bf0cd186fc094c8228",
      "bytes": 151670,
      "seconds": 1.719,
      "path": "assets/voices/source_adv_voice_linkstory_natsume_mahoro_10564_044.wav",
      "subtitle": "都说了对不起啦～！"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "啊，不是的，不是这样！",
      "textId": "adv_script_millsage_004_1_02_93",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 522,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_081.m4a",
      "cue": "adv_voice_millsage_004_1_02_081",
      "sourceType": "story",
      "sha256": "894bc403917865f854e1ed11896de037b57204ffb788f88015f325cb4bba1f0b",
      "nativeSha256": "a44827029c859410ea1e80cd24e42124c81f631585a93f01ce45f263f2b5c76f",
      "bytes": 209994,
      "seconds": 2.38,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_081.wav",
      "subtitle": "啊，不是的，不是这样！"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "你是……视频里的那个女孩，对吧？",
      "textId": "adv_script_millsage_004_1_02_94",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 524,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_082.m4a",
      "cue": "adv_voice_millsage_004_1_02_082",
      "sourceType": "story",
      "sha256": "3af243df390963c7eca09efb742bcb8488984dde9b505994b3b82f79204b24bc",
      "nativeSha256": "69e1ec388c466f8d8b87647b33cf9c4a65486ab2e79a217e0b71428b2bae7709",
      "bytes": 260974,
      "seconds": 2.958,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_082.wav",
      "subtitle": "你是……视频里的那个女孩，对吧？"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "啊，果然是有人擅自传上去的……",
      "textId": "adv_script_millsage_004_1_02_98",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 546,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_086.m4a",
      "cue": "adv_voice_millsage_004_1_02_086",
      "sourceType": "story",
      "sha256": "88346df61981bfd937b73b670333cdd0fcd020839730ebecd7f5d0d588950732",
      "nativeSha256": "20e1084f7334a8ebd36dd19b1413922e1b0461b60a1b89bd31ce0aacfb891bc2",
      "bytes": 261744,
      "seconds": 2.967,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_086.wav",
      "subtitle": "啊，果然是有人擅自传上去的……"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "所以我有些在意，就来看看你……",
      "textId": "adv_script_millsage_004_1_02_101",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 554,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_089.m4a",
      "cue": "adv_voice_millsage_004_1_02_089",
      "sourceType": "story",
      "sha256": "40d55dd60ba5974220854e5d5017d7b8e1a2f8f178d43efc3d546a80f1cf6112",
      "nativeSha256": "0b7f5294b0d3d87b9aceecdf4f44bf332e08709caa93d76f50cb545fd84bdddc",
      "bytes": 237426,
      "seconds": 2.691,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_089.wav",
      "subtitle": "所以我有些在意，就来看看你……"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "但我认为，现在正是我们新的起点",
      "textId": "adv_script_anotherstory_10451_25",
      "pageUrl": "https://bdon.moe/story/10451",
      "index": 155,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_anotherstory_10451/adv_voice_anotherstory_10451_023.m4a",
      "cue": "adv_voice_anotherstory_10451_023",
      "sourceType": "story",
      "sha256": "52dc289bbacc51d72126d875b433a9c22b4e3abd80df410246f630e9555e6517",
      "nativeSha256": "b843fb6ef88dfe7b0b90d4db4aca8b95415d0a0ab2ac4541f8a9cab4a37062dc",
      "bytes": 331094,
      "seconds": 3.753,
      "path": "assets/voices/source_adv_voice_anotherstory_10451_023.wav",
      "subtitle": "但我认为，现在正是我们新的起点"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "那个……你经常在这里弹钢琴吗？\n弹得特别好呢",
      "textId": "adv_script_millsage_004_1_02_110",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 600,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_098.m4a",
      "cue": "adv_voice_millsage_004_1_02_098",
      "sourceType": "story",
      "sha256": "8a43de75a1e7ad783efb8f1c2df553cae68a82b9d741b85a0bf284325b05f4b0",
      "nativeSha256": "129452f0f4a2d140c2334d81292ec9b42181150899fa69cd8274dd870b5586f7",
      "bytes": 540834,
      "seconds": 6.131,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_098.wav",
      "subtitle": "那个……你经常在这里弹钢琴吗？\n弹得特别好呢"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "你看，就是这个视频。\n那个『神秘的超强街头钢琴少女』",
      "textId": "adv_script_millsage_004_1_02_96",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 532,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_084.m4a",
      "cue": "adv_voice_millsage_004_1_02_084",
      "sourceType": "story",
      "sha256": "1d39f66f630086dae9834d744e8b81d4bb69c946765344e96930aff1f53a8a00",
      "nativeSha256": "bc5183f9081610007fab912893fb7b4a0c5559103e4f3a92d4e75cc2f479ff21",
      "bytes": 417882,
      "seconds": 4.737,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_084.wav",
      "subtitle": "你看，就是这个视频。\n那个『神秘的超强街头钢琴少女』"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "她真的在弹……millsage的曲子……！",
      "textId": "adv_script_millsage_004_1_02_86",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 464,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_074.m4a",
      "cue": "adv_voice_millsage_004_1_02_074",
      "sourceType": "story",
      "sha256": "a30676c01b2e02421acc27eb2efeaf7ed3fde603c00f02e58d3d6fc0bd9c54b8",
      "nativeSha256": "7efa91642f8a88578db8ff38bcbb544ff1c013a10e9ac191093de3ef65cf3aeb",
      "bytes": 368490,
      "seconds": 4.177,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_074.wav",
      "subtitle": "她真的在弹……millsage的曲子……！"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "这样啊。那可能最好找个懂这方面的人，\n问问怎么申请删除比较好",
      "textId": "adv_script_millsage_004_1_02_103",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 562,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_091.m4a",
      "cue": "adv_voice_millsage_004_1_02_091",
      "sourceType": "story",
      "sha256": "9dd8d4b787859d946fe46078b29bc45125bd2531ae513fc0737abc93ba83835c",
      "nativeSha256": "691d9a8f9436a25d8fa556a02e86c1b6e92edae1d075918d8561c9749470ef30",
      "bytes": 487470,
      "seconds": 5.526,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_091.wav",
      "subtitle": "这样啊。那可能最好找个懂这方面的人，\n问问怎么申请删除比较好"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "啊，突然搭话真不好意思……我叫滨崎茉幌。\n在水濑女子学园高中部读2年级哦",
      "textId": "adv_script_millsage_004_1_02_104",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 572,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_092.m4a",
      "cue": "adv_voice_millsage_004_1_02_092",
      "sourceType": "story",
      "sha256": "c513559eed2da9286563d526d2a74d60492607bb6b8d7e8a54dfd416f8c297a4",
      "nativeSha256": "c2f28696f118afb1f4fa5d7051dec40f564602300763697dfe338ce74a86f0af",
      "bytes": 603268,
      "seconds": 6.839,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_092.wav",
      "subtitle": "啊，突然搭话真不好意思……我叫滨崎茉幌。\n在水濑女子学园高中部读2年级哦"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "那、那个。其实我——",
      "textId": "adv_script_millsage_004_1_02_114",
      "pageUrl": "https://bdon.moe/story/10061",
      "index": 634,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_02/adv_voice_millsage_004_1_02_102.m4a",
      "cue": "adv_voice_millsage_004_1_02_102",
      "sourceType": "story",
      "sha256": "dd50b3d3c9ba9482afd19ba248e4b259fa2228de38849a56851d08f057b79fc1",
      "nativeSha256": "a5b0775612bdcfa07728ce651c2b9c8b4c427b63986b1dc76de8752c462ba98e",
      "bytes": 369282,
      "seconds": 4.186,
      "path": "assets/voices/source_adv_voice_millsage_004_1_02_102.wav",
      "subtitle": "那、那个。其实我——"
    },
    {
      "slug": "mahoro",
      "provider": "bdon.moe",
      "speaker": "mahoro",
      "speakerId": "adv_mahoro",
      "text": "还称不上认识……只是前几天，\n小萤弹钢琴的时候我过去搭了个话",
      "textId": "adv_script_millsage_004_1_03_136",
      "pageUrl": "https://bdon.moe/story/10062",
      "index": 759,
