      "pageUrl": "https://bdon.moe/story/10067",
      "index": 893,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_08/adv_voice_millsage_004_1_08_121.m4a",
      "cue": "adv_voice_millsage_004_1_08_121",
      "sourceType": "story",
      "sha256": "82a48df376183d2d42c62ab6b4ac3850fbdc65842ddf7c5981954b18af892337",
      "nativeSha256": "baf8114d7964c809622cc815f841a1e025d96685dc6e010bfa3879da5feb8ea9",
      "bytes": 172054,
      "seconds": 1.95,
      "path": "assets/voices/source_adv_voice_millsage_004_1_08_121.wav",
      "subtitle": "喂，赶紧开始了！"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "倒是值得一试",
      "textId": "adv_script_millsage_004_1_14_112",
      "pageUrl": "https://bdon.moe/story/10073",
      "index": 825,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_14/adv_voice_millsage_004_1_14_107.m4a",
      "cue": "adv_voice_millsage_004_1_14_107",
      "sourceType": "story",
      "sha256": "28c322952149f4e7091776cb806082bcaf12f62c094efb281a6fc5f45a648f62",
      "nativeSha256": "ab190a0ed704ab00bb945660a3d3250d9f4dd6b1c49bc6fb6a3f56bf08aeed22",
      "bytes": 164304,
      "seconds": 1.862,
      "path": "assets/voices/source_adv_voice_millsage_004_1_14_107.wav",
      "subtitle": "倒是值得一试"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "万一你真能让我认可的话，\n那加入乐队的事，我倒是可以考虑考虑",
      "textId": "adv_script_millsage_004_1_04_157",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 1063,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_155.m4a",
      "cue": "adv_voice_millsage_004_1_04_155",
      "sourceType": "story",
      "sha256": "155545c926a94f021c33c3781a6cb9dce80f2a88ceeafc380f3d6c735c0b3a26",
      "nativeSha256": "620160a72d550e4f45c227c1e3912d60bf9692e2b7eebd9383c61aaa6618a59d",
      "bytes": 592512,
      "seconds": 6.717,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_155.wav",
      "subtitle": "万一你真能让我认可的话，\n那加入乐队的事，我倒是可以考虑考虑"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "哼？我这个天才吉他手，\n怎么可能输给这种外行？",
      "textId": "adv_script_millsage_004_1_04_158",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 1075,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_156.m4a",
      "cue": "adv_voice_millsage_004_1_04_156",
      "sourceType": "story",
      "sha256": "506be32f47c0a54e48b8d648d01b84548af35e2dd8f7cea0f4575808d6ad0b26",
      "nativeSha256": "8ff3db5beb807202af2f5e8972cf0e27f7f91501a29a0af2828d3f30d0942c2c",
      "bytes": 635276,
      "seconds": 7.202,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_156.wav",
      "subtitle": "哼？我这个天才吉他手，\n怎么可能输给这种外行？"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "是谁说要搞练习集训的！\n结果聊天打游戏闹了个通宵就结束了！",
      "textId": "adv_script_millsage_004_1_05_23",
      "pageUrl": "https://bdon.moe/story/10064",
      "index": 235,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_05/adv_voice_millsage_004_1_05_023.m4a",
      "cue": "adv_voice_millsage_004_1_05_023",
      "sourceType": "story",
      "sha256": "d6e58a0a0a829ddb2b2c3901213d095e3848fc8c6a87997cf1a3832bd5dd199a",
      "nativeSha256": "263b324a897ec60146c4755393360256fdfe31de3b40507d71660ca11b4a3190",
      "bytes": 547346,
      "seconds": 6.205,
      "path": "assets/voices/source_adv_voice_millsage_004_1_05_023.wav",
      "subtitle": "是谁说要搞练习集训的！\n结果聊天打游戏闹了个通宵就结束了！"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "能站上乐队的圣地，简直太Cool了！",
      "textId": "adv_script_millsage_004_1_19_219",
      "pageUrl": "https://bdon.moe/story/10078",
      "index": 1521,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_19/adv_voice_millsage_004_1_19_210.m4a",
      "cue": "adv_voice_millsage_004_1_19_210",
      "sourceType": "story",
      "sha256": "b3d0eb6d7b87bdf11108f41efb7052603fd0e54cc9d69ff02c42d262f919b0e1",
      "nativeSha256": "d809e5981418f367b9c60ae7a15ca0f5800cb986c6245c3d952569dfd1d3a66e",
      "bytes": 332770,
      "seconds": 3.772,
      "path": "assets/voices/source_adv_voice_millsage_004_1_19_210.wav",
      "subtitle": "能站上乐队的圣地，简直太Cool了！"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "哼。把打工的钱都砸在设备上，这才叫乐队人",
      "textId": "adv_script_natsume_nagi_linkstory_2_24",
      "pageUrl": "https://bdon.moe/story/10562",
      "index": 159,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_linkstory_natsume_nagi_10562/adv_voice_linkstory_natsume_nagi_10562_023.m4a",
      "cue": "adv_voice_linkstory_natsume_nagi_10562_023",
      "sourceType": "story",
      "sha256": "51ad48c306e3d0624baf0d8533bf8529ea2261248dcc77bc597696849a157775",
      "nativeSha256": "2bf4d220a7d5ddc7f29cf094a8211b0d3c5c457f861d660af0203cc4a2b8cede",
      "bytes": 358170,
      "seconds": 4.06,
      "path": "assets/voices/source_adv_voice_linkstory_natsume_nagi_10562_023.wav",
      "subtitle": "哼。把打工的钱都砸在设备上，这才叫乐队人"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "……你会唱歌怎么不早说啊",
