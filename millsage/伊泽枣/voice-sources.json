      "nativeSha256": "46b2d9361a106ea974306504fd46eca882cba8964bf7d4b2344430b1a930f122",
      "bytes": 212532,
      "seconds": 2.409,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_175.wav",
      "subtitle": "此Cool非彼Cool啦！"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "反正也就是个会弹跳蚤圆舞曲的水平吧",
      "textId": "adv_script_millsage_004_1_04_146",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 984,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_144.m4a",
      "cue": "adv_voice_millsage_004_1_04_144",
      "sourceType": "story",
      "sha256": "3e1067e3248db4874c8518da065539bffffcad5ad936061e9cfeb6d8a7a68176",
      "nativeSha256": "f712d46f82747a29b1abc422aaf6b5a73c0a9cf980d479fbdc9629398d128f78",
      "bytes": 198076,
      "seconds": 2.245,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_144.wav",
      "subtitle": "反正也就是个会弹跳蚤圆舞曲的水平吧"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "我怎么可能愿意！\n居然把人硬拽到这种地方来！",
      "textId": "adv_script_millsage_004_1_04_125",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 862,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_123.m4a",
      "cue": "adv_voice_millsage_004_1_04_123",
      "sourceType": "story",
      "sha256": "cc57861952d12bf96d51c1c13a15f8b6d6ad443188d8b0ce6c3a9ddc6d0bbeab",
      "nativeSha256": "b53794fa3a859c08333ada30ef6f0b6c65e8112915ff5732b195586a996822b4",
      "bytes": 276586,
      "seconds": 3.135,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_123.wav",
      "subtitle": "我怎么可能愿意！\n居然把人硬拽到这种地方来！"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "哼。我跟你们这些平庸之辈可不一样，\n不爱扎堆",
      "textId": "adv_script_millsage_004_1_04_135",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 920,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_133.m4a",
      "cue": "adv_voice_millsage_004_1_04_133",
      "sourceType": "story",
      "sha256": "b3cbd981f0c4c4ba62239d17eab838e2810594a96a118cbf3eb7a98047df8076",
      "nativeSha256": "3e5600f448d82f494db0cc4761c55eb43535b6cfd5f3aaa2afd528201b2d45c8",
      "bytes": 535172,
      "seconds": 6.067,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_133.wav",
      "subtitle": "哼。我跟你们这些平庸之辈可不一样，\n不爱扎堆"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "既然定了，那就马上开练。\n还得把每首歌的唱段分一分呢",
      "textId": "adv_script_millsage_004_1_14_121",
      "pageUrl": "https://bdon.moe/story/10073",
      "index": 879,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_14/adv_voice_millsage_004_1_14_116.m4a",
      "cue": "adv_voice_millsage_004_1_14_116",
      "sourceType": "story",
      "sha256": "2493f0505e6014995b2ce8f3f0875fc1fbd6c133921184095854e51359d6b11f",
      "nativeSha256": "491456895de53a14317a659af709e988858112dad7b44fa76afebbb004ee8677",
      "bytes": 408444,
      "seconds": 4.63,
      "path": "assets/voices/source_adv_voice_millsage_004_1_14_116.wav",
      "subtitle": "既然定了，那就马上开练。\n还得把每首歌的唱段分一分呢"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "你这家伙到底什么毛病！\n我说了多少遍放开我，你都完全不听！\n我要回去了",
      "textId": "adv_script_millsage_004_1_04_129",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 885,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_127.m4a",
      "cue": "adv_voice_millsage_004_1_04_127",
      "sourceType": "story",
      "sha256": "c18a1e957fd3027c74c64ea525af9d9a50ca82ac7cf20f238a0d5d68456a5494",
      "nativeSha256": "3466b2c8cf0e4b4fe2a8ebacfb155a5b4a58e9080f974ff31edd7dc8b257701f",
      "bytes": 526810,
      "seconds": 5.972,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_127.wav",
      "subtitle": "你这家伙到底什么毛病！\n我说了多少遍放开我，你都完全不听！\n我要回去了"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "……伊泽枣",
      "textId": "adv_script_millsage_004_1_04_132",
      "pageUrl": "https://bdon.moe/story/10063",
      "index": 905,
      "url": "https://assets.bdon.moe/zh-Hans/Cri/Sound/adv_voice_millsage_004_1_04/adv_voice_millsage_004_1_04_130.m4a",
      "cue": "adv_voice_millsage_004_1_04_130",
      "sourceType": "story",
      "sha256": "6145be45d6634011b4f4253876e536d2b0dd3ed12994ec82c63f2df62029191b",
      "nativeSha256": "974023bfb099c600a32f4c622ad460db9ac96e8cea5df7d6f543d9af53447a47",
      "bytes": 123454,
      "seconds": 1.399,
      "path": "assets/voices/source_adv_voice_millsage_004_1_04_130.wav",
      "subtitle": "……伊泽枣"
    },
    {
      "slug": "natsume",
      "provider": "bdon.moe",
      "speaker": "natsume",
      "speakerId": "adv_natsume",
      "text": "喂，赶紧开始了！",
